# Demo database (SQLite)
MAGI_DB=./data/magi.db

# Session signing. Change for anything beyond the demo.
MAGI_SECRET=magi-demo-secret-change-me
MAGI_PASSWORD=demo
MAGI_SECURE_COOKIE=0
MAGI_CORS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=1

# Optional OpenAI-compatible provider for Magi.
# Leave MAGI_API_KEY empty to use the local rule-based engine (offline demo).
MAGI_BASE_URL=https://api.openai.com/v1
MAGI_API_KEY=
MAGI_MODEL=gpt-4.1-mini

# Telegram-бот Magi (отдельный процесс: python -m server.telegram_bot)
MAGI_TELEGRAM_TOKEN=
